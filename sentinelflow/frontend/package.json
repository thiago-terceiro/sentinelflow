{
  "name": "sentinelflow-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "node --experimental-strip-types --test",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --grep @visual",
    "check:rules": "node scripts/check-rules.js",
    "codegen:types": "node scripts/generate-types.js"
  },
  "dependencies": {
    "next": "^16.4.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.2"
  }
}
