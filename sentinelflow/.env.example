APP_ENV=development
SEED_DEMO_DATA=true
API_HOST=0.0.0.0
API_PORT=8000
ENABLE_API_DOCS=true
ALLOWED_HOSTS=["localhost","127.0.0.1","proxy","backend"]
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sentinelflow
LANGGRAPH_CHECKPOINT_URL=postgresql://postgres:postgres@localhost:5432/sentinelflow
QUEUE_REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=
MODEL_NAME=gpt-4.1-mini
MODEL_BASE_URL=
OTEL_SERVICE_NAME=sentinelflow-agent-engine
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
AUDIT_ARTIFACT_KEY_ID=v1
AUDIT_ARTIFACT_ENCRYPTION_KEY=
AUTH_ISSUER=sentinelflow-dev
AUTH_AUDIENCE=sentinelflow-api
AUTH_JWT_SECRET=change-me
AUTH_ALLOWED_ALGORITHMS=["RS256","ES256","PS256","HS256"]
AUTH_OIDC_ISSUER=
AUTH_OIDC_DISCOVERY_URL=
AUTH_JWKS_URL=
AUTH_RESOURCE_CLIENT_ID=
AUTH_ROLE_MAP={}
AUTH_ALLOW_DEV_TOKENS=true

AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_SCOPE=openid profile email
AUTH_OIDC_CALLBACK_PATH=/auth/callback
AUTH_POST_LOGIN_PATH=/
AUTH_POST_LOGOUT_PATH=/

INTERNAL_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=/api/v1
INTERNAL_ACCESS_TOKEN_COOKIE_NAME=sentinelflow_access_token
INTERNAL_ID_TOKEN_COOKIE_NAME=sentinelflow_id_token
DEPLOYMENT_VERSION=local-dev

# Smoke test controls
SMOKE_AUTH_MODE=dev_tokens
SMOKE_BASE_URL=http://127.0.0.1:8080
SMOKE_INVESTIGATOR_TOKEN=
SMOKE_REVIEWER_TOKEN=
SMOKE_REQUIRE_PROVIDER=false
SMOKE_REQUIRE_TELEMETRY=false

# Production compose profile guidance (set in your real env file, not defaults)
# APP_ENV=production
# ENABLE_API_DOCS=false
# AUTH_ALLOW_DEV_TOKENS=false
# AUTH_JWT_SECRET=replace-with-strong-secret
# OPENAI_API_KEY=replace-with-real-key
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example/v1/traces
